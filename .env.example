# DevShare secrets: one webhook URL per destination.
#
# Copy this file to the folder that holds your DevShare config.json and name it .env
# (on Windows: %APPDATA%\DevShare\.env), then fill in your own webhook URLs.
# Each variable name must match a destination's "webhookEnv" in config.json.
#
# Never commit a filled-in copy of this file. Real environment variables with the
# same name take precedence over values in this file.

DEVSHARE_GENERAL_WEBHOOK=
DEVSHARE_BACKEND_WEBHOOK=
