{
  "name": "devshare",
  "private": true,
  "description": "Quickly share copied text, code, logs, screenshots, and files from your development environment to configured destinations.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhi9871/dev-share.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "devshare": "node packages/cli/dist/index.js",
    "desktop": "npm run start -w @devshare/desktop",
    "desktop:dev": "npm run dev -w @devshare/desktop",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
